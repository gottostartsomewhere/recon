# ── Recon configuration ──────────────────────────────────────────────
# Copy this file to ".env" and paste in your two keys.
# Without keys, Recon still runs in DEMO mode (a scripted sample dossier).

# Nebius Token Factory — NVIDIA Nemotron inference.  https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# Tavily — web search, extract and crawl.  Get a key: https://app.tavily.com
TAVILY_API_KEY=

# Optional overrides. Each tier falls back to the next model in its chain if
# Token Factory does not list the one configured here.
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEMOTRON_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEMOTRON_AGENT=nvidia/nemotron-3-super-120b-a12b
# NEMOTRON_JUDGE=nvidia/Nemotron-3-Ultra-550b-a55b
# PORT=8787
